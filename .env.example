# Optional tower briefing. Both settings are required; there is no default model.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional planning review CLI; environment variables only, never browser variables.
# A dedicated key takes precedence over OPENAI_API_KEY. Alternatively use --prompt-key.
DECISIONS_API_KEY=
DECISIONS_MODEL=gpt-6-luna

# Optional Windy connection check only; Testing-tier values must not feed forecasts.
# Point Forecast key, not a Plugins or Map Forecast key. Server-side only.
WINDY_POINT_FORECAST_API_KEY=
